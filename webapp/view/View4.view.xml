<mvc:View controllerName="com.demo.b82sapui5app.controller.View4"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form">
    <Page title="Edit Employee View" showNavButton="true" navButtonPress="onBackPress">
        <content>
            <f:SimpleForm title="Employee Details" editable="true" layout="ResponsiveGridLayout" labelSpanL="2" labelSpanM="2" emptySpanL="5" emptySpanM="5">
                <f:content>
                    <Label text="Employee ID" required="true"></Label>
                    <Input id="oIpEmpId" value="{oModel>Empid}" enabled="false"></Input>
                    <Label text="Name" required="true"></Label>
                    <Input id="oIpName" value="{oModel>Name}"></Input>
                    <Label text="Designation" required="true"></Label>
                    <Input id="oIpDesig" value="{oModel>Desig}"></Input>
                    <Label text="Email" required="true"></Label>
                    <Input id="oIpEmail" value="{oModel>Email}"></Input>
                    <Label text="Phone No." required="true"></Label>
                    <Input id="oIpPhone" value="{oModel>Phone}"></Input>
                    <Label text="Salary" required="true"></Label>
                    <Input id="oIpSalary" value="{oModel>Salary}"></Input>
                    <Label text="Status" required="true"></Label>
                    <Input id="oIpStatus" value="{oModel>Status}"></Input>
                    <Label text="Rating" required="true"></Label>
                    <Input id="oIpRating" value="{oModel>Rating}"></Input>
                </f:content>
            </f:SimpleForm>
        </content>
        <footer>
            <Bar>
                <contentRight>
                    <Button text="Save" press="onPressSave" type="Accept"></Button>
                    <Button text="Cancel" press="onPressBack" type="Reject"></Button>
                </contentRight>
            </Bar>
        </footer>
    </Page>
</mvc:View>