<mvc:View controllerName="com.demo.b82sapui5app.controller.View1"
   xmlns:mvc="sap.ui.core.mvc"
   xmlns="sap.m"
   xmlns:l="sap.ui.layout"
   xmlns:f="sap.ui.layout.form"
   xmlns:core="sap.ui.core">
   <Page title="I am View1">
      <content>
         <Panel headerText="Search Employees" expandable="true" expanded="true">
            <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanL="3" emptySpanL="0" columnsL="3">
               <f:content>
                  <core:Title text="Filters"></core:Title>
                  <Label text="Employee Id"></Label>
                  <Input id="oIpEmpId" showValueHelp="true" valueHelpRequest="onPressVH"></Input>
                  <Label text="Salary"></Label>
                  <ComboBox id="oSelOpr">
                     <items>
                        <core:Item text="Equals" key="EQ"></core:Item>
                        <core:Item text="Greater than" key="GT"></core:Item>
                        <core:Item text="Less than" key="LT"></core:Item>
                     </items>
                  </ComboBox>
                  <Input id="oIpSalary"></Input>
                  <core:Title text="Sorters"></core:Title>
                  <Label text="Sort Field"></Label>
                  <ComboBox id="oCBSortField">
                     <items>
                        <core:Item text="Employee Id" key="Empid"></core:Item>
                        <core:Item text="Employee Name" key="Name"></core:Item>
                        <core:Item text="Designation" key="Desig"></core:Item>
                        <core:Item text="Salary" key="Salary"></core:Item>
                     </items>
                  </ComboBox>
                  <Label text="Sort Order"></Label>
                  <RadioButtonGroup id="oRbgSortOrder" columns="2" selectedIndex="-1">
                     <buttons>
                        <RadioButton text="Ascending"></RadioButton>
                        <RadioButton text="Descending"></RadioButton>
                     </buttons>
                  </RadioButtonGroup>
                   <core:Title text="Group"></core:Title>
                  <Label text="Group Field"></Label>
                  <ComboBox id="oCBGroupField">
                     <items>
                        <core:Item text="Designation" key="Desig"></core:Item>
                     </items>
                  </ComboBox>
                  <Label text="Group Order"></Label>
                  <RadioButtonGroup id="oRbgGroupOrder" columns="2" selectedIndex="-1">
                     <buttons>
                        <RadioButton text="Ascending"></RadioButton>
                        <RadioButton text="Descending"></RadioButton>
                     </buttons>
                  </RadioButtonGroup>
               </f:content>
            </f:SimpleForm>
            <FlexBox justifyContent="End">
               <Button text="Go" icon="sap-icon://accept" type="Accept" press="onPressGo"></Button>
               <Button text="Reset" icon="sap-icon://reset" type="Reject" class="sapUiTinyMarginBegin" press="onReset"></Button>
            </FlexBox>
         </Panel>
         <Table id="oEmpTable" class="sapUiSmallMargin" width="auto" items="{oModel>/EmployeeSet}" mode="SingleSelectLeft">
            <headerToolbar>
               <Toolbar >
                  <Title text="Employee Details"></Title>
                  <ToolbarSpacer ></ToolbarSpacer>
                  <Button text="Create Employee" icon="sap-icon://add" press="onCreateEmp" type="Emphasized"></Button>
                  <Button text="Edit Employee" icon="sap-icon://edit" press="onEditEmp" type="Emphasized"></Button>
                  <Button text="Delete Employee" icon="sap-icon://delete" press="onDeleteEmp" type="Reject"></Button>
                  <Button icon="sap-icon://excel-attachment" type="Emphasized" press="onExportToExcel"></Button>
               </Toolbar>
            </headerToolbar>
            <columns>
               <Column>
                  <Text text="Employee ID"></Text>
               </Column>
               <Column>
                  <Text text="Name"></Text>
               </Column>
               <Column>
                  <Text text="Designation"></Text>
               </Column>
               <Column>
                  <Text text="Email"></Text>
               </Column>
               <Column>
                  <Text text="Salary"></Text>
               </Column>
               <Column>
                  <Text text="Status"></Text>
               </Column>
            </columns>
            <items>
               <ColumnListItem type="Navigation" press="onPress">
                  <Text text="{oModel>Empid}"></Text>
                  <Text text="{oModel>Name}"></Text>
                  <Text text="{path:'oModel>Desig', formatter:'.f.formatDesig'}"></Text>
                  <Text text="{oModel>Email}"></Text>
                  <Text text="{oModel>Salary}"></Text>
                  <ObjectStatus text="{oModel>Status}" state="{path:'oModel>Status', formatter:'.f.formatStatus'}" inverted="true" icon="{path:'oModel>Status', formatter:'.f.formatIcon'}"></ObjectStatus>
               </ColumnListItem>
            </items>
         </Table>

        
      </content>
      <footer>
         <Bar >
            <contentRight>
               <Button text="Submit" press="onSubmit" type="Emphasized"></Button>
            </contentRight>
         </Bar>
      </footer>
   </Page>
</mvc:View>