<mvc:View controllerName="com.demo.b82sapui5app.controller.View1"
   xmlns:mvc="sap.ui.core.mvc"
   xmlns="sap.m">
   <Page title="I am View1">
      <content>
         <Text id="oTxtWelcome" text="Welcome to SAPUI5" textAlign="Center" width="100%" class="sapMH1FontSize"></Text>
         <Label text="Enter you name" class="sapUiSmallMarginBegin sapUiTinyMarginTop"></Label>
         <Input id="oIpName" width="30%" class="sapUiTinyMarginBegin" value=""></Input>
         <Label text="Alignment" class="sapUiSmallMarginBegin sapUiTinyMarginTop"></Label>
         <Input id="oIpAlignment" width="40%" class="sapUiTinyMarginBegin" value=""></Input>
         <Label text="Which signal you want to turn on?" class="sapUiSmallMarginBegin sapUiTinyMarginTop"></Label>
         <Input id="oIpSignal" width="30%" class="sapUiTinyMarginBegin" value=""></Input>

         <Button id="oBtnSubmit" text="Submit" type="Emphasized" press="onSubmit" class="sapUiTinyMarginBegin"></Button>
      </content>
      <footer>
         <Bar >
            <contentLeft>
               <Button id="oBtnRed" text="Red" type="" ></Button>
            </contentLeft>
            <contentMiddle>
               <Button id="oBtnBlue" text="Blue" type="" ></Button>
            </contentMiddle>
            <contentRight>
               <Button id="oBtnGreen" text="Green" type="" ></Button>
            </contentRight>

         </Bar>
      </footer>
   </Page>
</mvc:View>