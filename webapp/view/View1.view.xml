<mvc:View controllerName="com.demo.b82sapui5app.controller.View1"
   xmlns:mvc="sap.ui.core.mvc"
   xmlns="sap.m"
   xmlns:l="sap.ui.layout"
   xmlns:f="sap.ui.layout.form"
   xmlns:core="sap.ui.core">
   <Page title="I am View1">
      <content>
         <f:SimpleForm title="Employee Details(1 field per row)" editable="true" layout="ResponsiveGridLayout" labelSpanXL="2" labelSpanL="2" labelSpanM="2" labelSpanS="12" emptySpanXL="6" emptySpanL="6" emptySpanM="6">
            <f:content>
               <Label text="Employee Id" required="true"></Label>
               <Input id="oIpEmpId"></Input>
               <Label text="Name" required="true"></Label>
               <Input id="oIpName"></Input>
               <Label text="Designation" required="true"></Label>
               <Input id="oIpDesig"></Input>
               <Label text="Skill" required="true"></Label>
               <Input id="oIpSkill"></Input>
               <Label text="Email Id" required="true"></Label>
               <Input id="oIpEmail"></Input>
               <Label text="Status" required="true"></Label>
               <Input id="oIpStatus"></Input>
            </f:content>
         </f:SimpleForm>
      </content>
      <footer>
         <Bar >
            <contentRight>
               <Button text="Submit" press="onSubmit" type="Emphasized"></Button>
            </contentRight>
         </Bar>
      </footer>
   </Page>
</mvc:View>