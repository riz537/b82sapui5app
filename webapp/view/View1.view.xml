<mvc:View controllerName="com.demo.b82sapui5app.controller.View1"
   xmlns:mvc="sap.ui.core.mvc"
   xmlns="sap.m"
   xmlns:l="sap.ui.layout"
   xmlns:f="sap.ui.layout.form"
   xmlns:core="sap.ui.core">
   <Page title="I am View1">
      <content>
         <f:SimpleForm id="idSimpleForm" title="Multi value UI elements Demo" layout="ResponsiveGridLayout" editable="true" labelSpanL="3" labelSpanM="3" emptySpanL="4" emptySpanM="4" columnsL="1" columnsM="1">
            <f:content>
               <Label text="I am a Select Box"></Label>
               <Select id="oSel" items="{oModel>/EmployeeSet}" change="onSelectChange">
                  <items>
                     <core:Item text="{oModel>Name}" key="{oModel>Name}"></core:Item>
                  </items>
               </Select>
               <Label text="I am a ComboBox"></Label>
               <ComboBox id="oCB" items="{oModel>/EmployeeSet}" selectionChange="onSelFromCB">
                  <items>
                     <core:Item text="{oModel>Name}" key="{oModel>Name}"></core:Item>
                  </items>
               </ComboBox>
               <Label text="I am a MultiComboBox"></Label>
               <MultiComboBox id="oMCB" items="{oModel>/EmployeeSet}" showSelectAll="true" selectionFinish="onSelFromMCB">
                  <items>
                     <core:Item text="{oModel>Name}" key="{oModel>Name}"></core:Item>
                  </items>
               </MultiComboBox>
               <Label text="I am a radio button group"></Label>
               <RadioButtonGroup id="oRBG" buttons="{oModel>/EmployeeSet}" columns="5" selectedIndex="1" select="onSelectFromRBG">
                  <buttons>
                     <RadioButton text="{oModel>Name}" ></RadioButton>
                  </buttons>
               </RadioButtonGroup>

            </f:content>
         </f:SimpleForm>


