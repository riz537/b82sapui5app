<mvc:View controllerName="com.demo.b82sapui5app.controller.View1"
   xmlns:mvc="sap.ui.core.mvc"
   xmlns="sap.m"
   xmlns:l="sap.ui.layout"
   xmlns:f="sap.ui.layout.form"
   xmlns:core="sap.ui.core">
   <Page title="I am View1">
      <content>
         <Table class="sapUiSmallMargin" width="auto" items="{oModel>/EmployeeSet}">
            <headerToolbar>
               <Toolbar >
                  <Title text="Employee Details"></Title>
               </Toolbar>
            </headerToolbar>
            <columns>
               <Column>
                  <Text text="Employee ID"></Text>
               </Column>
               <Column>
                  <Text text="Name"></Text>
               </Column>
               <Column>
                  <Text text="Designation"></Text>
               </Column>
               <Column>
                  <Text text="Email"></Text>
               </Column>
               <Column>
                  <Text text="Status"></Text>
               </Column>
            </columns>
            <items>
               <ColumnListItem >
                  <Text text="{oModel>Empid}"></Text>
                  <Text text="{oModel>Name}"></Text>
                  <Text text="{oModel>Desig}"></Text>
                  <Text text="{oModel>Email}"></Text>
                  <Text text="{oModel>Status}"></Text>
               </ColumnListItem>
            </items>
         </Table>
      </content>
      <footer>
         <Bar >
            <contentRight>
               <Button text="Submit" press="onSubmit" type="Emphasized"></Button>
            </contentRight>
         </Bar>
      </footer>
   </Page>
</mvc:View>